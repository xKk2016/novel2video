{
  "_comment": "MiniMax H3 FL2VA (first-last frame to video+audio) API workflow. Derived from h3_t2v_api.json; switched to the pruned int8 ref2va/fl2va weight set for speed on 16GB VRAM. Adds first_frame / last_frame LoadImage inputs on MiniMaxH3ImageToVideo for chained keyframe generation.",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "11": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "3",
        0
      ]
    }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "3",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "prompt": "AUTO_INJECT_PLACEHOLDER_PROMPT_FOR_MINIMAX_H3_IMAGE_TO_VIDEO_NODE_PLEASE_REPLACE_THIS_LONG_STRING_AUTO_INJECT",
      "width": 1344,
      "height": 768,
      "length": 124,
      "first_frame": [
        "20",
        0
      ],
      "last_frame": [
        "21",
        0
      ]
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        1
      ],
      "seed": 42,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "12": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "11",
        0
      ]
    }
  },
  "9": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "audio": [
        "12",
        0
      ],
      "fps": 24
    }
  },
  "10": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "9",
        0
      ],
      "filename_prefix": "novel2video/h3_fl2va",
      "format": "mp4",
      "codec": "h264",
      "codec.encoding": "re-encode",
      "codec.encoding.crf": 16
    }
  },
  "20": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "keyframes/shot_000_first.png"
    }
  },
  "21": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "keyframes/shot_000_last.png"
    }
  }
}
